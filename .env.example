# Telegram
TELEGRAM_BOT_TOKEN=
# Optional comma-separated Telegram numeric user IDs. Empty = no restriction.
TELEGRAM_ALLOWED_USER_IDS=

# JEV / TypeSafe
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MAX_CHARS=90000

# Optional reasoning model for /ask and narrative explanations.
# Any OpenAI-compatible /chat/completions endpoint can be used.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

LOG_LEVEL=INFO
